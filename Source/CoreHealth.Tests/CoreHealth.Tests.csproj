<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Eternal Core Health: the pure verdict and alert rules. The agent's wiring
         (MarkIIIHost.Health.cs: HTTP read, TV probe, endpoints) builds only in CI. -->
    <Compile Include="../GamingModeAgent/GamingMode.Services/CoreHealth.cs" Link="CoreHealth.cs" />
    <Compile Include="../GamingModeAgent/GamingMode.Services/UpdateNight.cs" Link="UpdateNight.cs" />
    <!-- Console guards: the pure rules and the BitLocker guard's task XML, script and check file. -->
    <Compile Include="../GamingModeAgent/GamingMode.Services/ConsoleGuards.cs" Link="ConsoleGuards.cs" />
    <Compile Include="../Shared/BitLockerGuard.cs" Link="BitLockerGuard.cs" />
    <!-- The full schema 1 shape (every optional section filled). -->
    <None Include="core-status.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Exactly what Aincrad's scripts/backup.sh writes. -->
    <None Include="core-status.aincrad.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
