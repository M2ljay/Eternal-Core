<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Eternal Core Health: the pure verdict and alert rules. The agent's wiring
         (MarkIIIHost.Health.cs: HTTP read, TV probe, endpoints) builds only in CI. -->
    <Compile Include="../GamingModeAgent/GamingMode.Services/CoreHealth.cs" Link="CoreHealth.cs" />
    <Compile Include="../GamingModeAgent/GamingMode.Services/UpdateNight.cs" Link="UpdateNight.cs" />
    <!-- Console guards: the pure rules and the BitLocker guard's task XML, script and check file. -->
    <Compile Include="../GamingModeAgent/GamingMode.Services/ConsoleGuards.cs" Link="ConsoleGuards.cs" />
    <Compile Include="../Shared/BitLockerGuard.cs" Link="BitLockerGuard.cs" />
    <!-- Batch 1: save backup (Ludusavi), Decky plugin logs, bedtime wind-down. -->
    <Compile Include="../GamingModeAgent/GamingMode.Services/SaveBackup.cs" Link="SaveBackup.cs" />
    <Compile Include="../GamingModeAgent/GamingMode.Services/DeckyPluginLogs.cs" Link="DeckyPluginLogs.cs" />
    <Compile Include="../GamingModeAgent/GamingMode.Services/WindDown.cs" Link="WindDown.cs" />
    <!-- Batch 2: MQTT, the Home Assistant bridge, automations, sleep after streaming (and the stream log it reads). -->
    <Compile Include="../GamingModeAgent/GamingMode.Services/MqttWire.cs" Link="MqttWire.cs" />
    <Compile Include="../GamingModeAgent/GamingMode.Services/HomeAssistantBridge.cs" Link="HomeAssistantBridge.cs" />
    <Compile Include="../GamingModeAgent/GamingMode.Services/StreamPower.cs" Link="StreamPower.cs" />
    <Compile Include="../GamingModeAgent/GamingMode.Services/CoreStreamMode.cs" Link="CoreStreamMode.cs" />
    <Compile Include="../Shared/CoreAutomations.cs" Link="CoreAutomations.cs" />
    <!-- Jarvis: the shared core (requests, answers, prompts, audio, Wyoming, the secret store) and the agent's rules. -->
    <Compile Include="../Shared/CoreSecretStore.cs" Link="CoreSecretStore.cs" />
    <Compile Include="../Shared/JarvisCore.cs" Link="JarvisCore.cs" />
    <Compile Include="../Shared/JarvisClient.cs" Link="JarvisClient.cs" />
    <Compile Include="../Shared/JarvisWyoming.cs" Link="JarvisWyoming.cs" />
    <Compile Include="../Shared/JarvisSecretStore.cs" Link="JarvisSecretStore.cs" />
    <Compile Include="../GamingModeAgent/GamingMode.Services/Jarvis.cs" Link="Jarvis.cs" />
    <!-- The full schema 1 shape (every optional section filled). -->
    <None Include="core-status.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Exactly what Aincrad's scripts/backup.sh writes. -->
    <None Include="core-status.aincrad.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
