<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <Import Project="..\EternalRelease.props" />
  <PropertyGroup>
    <AssemblyName>GamingMode</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Playhub.XboxSession/SteamXboxProfileWindow.cs" Link="SteamXboxProfileWindow.cs" />
    <Compile Include="../Playhub.XboxSession/IRetainedSteamGameTarget.cs" Link="IRetainedSteamGameTarget.cs" />
    <Compile Include="../Playhub.XboxSession/SteamMirrorWireProtocol.cs" Link="SteamMirrorWireProtocol.cs" />
    <Compile Include="../Playhub.XboxSession/SteamNativeOverlayInputWire.cs" Link="SteamNativeOverlayInputWire.cs" />
    <Compile Include="../Playhub.XboxSession/SteamNativeOverlayInputPresentationBridge.cs" Link="SteamNativeOverlayInputPresentationBridge.cs" />
    <Compile Include="../Shared/DeckyStartupGuard.cs" Link="DeckyStartupGuard.cs" />
    <Compile Include="../Shared/SteamStartupMovie.cs" Link="SteamStartupMovie.cs" />
    <Compile Include="../Shared/LegacyXboxGameBarWatcher.cs" Link="LegacyXboxGameBarWatcher.cs" />
    <Compile Include="../Playhub.DeckyHost/DeckyProcessTree.cs" Link="DeckyProcessTree.cs" />
    <Compile Include="../Shared/UwpSessionIdentity.cs" Link="UwpSessionIdentity.cs" />
    <Compile Include="../Shared/SplashLogoScale.cs" Link="SplashLogoScale.cs" />
    <Compile Include="../Shared/CouchHardening.cs" Link="CouchHardening.cs" />
    <Compile Include="../Shared/CouchRegistryWindows.cs" Link="CouchRegistryWindows.cs" />
    <Compile Include="../Shared/BitLockerGuard.cs" Link="BitLockerGuard.cs" />
    <Compile Include="../Shared/BitLockerGuard.Windows.cs" Link="BitLockerGuard.Windows.cs" />
    <Compile Include="../Shared/DeckySteamPairing.cs" Link="DeckySteamPairing.cs" />
    <Compile Include="../Shared/SteamClientKindProbe.cs" Link="SteamClientKindProbe.cs" />
    <!-- Batch 2: automations (shared with the app) and the DPAPI store for the Home Assistant password. -->
    <Compile Include="../Shared/CoreAutomations.cs" Link="CoreAutomations.cs" />
    <Compile Include="../Shared/CoreSecretStore.cs" Link="CoreSecretStore.cs" />
    <!-- Jarvis: requests, prompts, audio, Wyoming and the DPAPI store for the token and keys (docs/eternal/JARVIS.md). -->
    <Compile Include="../Shared/JarvisCore.cs" Link="JarvisCore.cs" />
    <Compile Include="../Shared/JarvisClient.cs" Link="JarvisClient.cs" />
    <Compile Include="../Shared/JarvisWyoming.cs" Link="JarvisWyoming.cs" />
    <Compile Include="../Shared/JarvisSecretStore.cs" Link="JarvisSecretStore.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- Private, default-OFF HUD trial. Does not enable the mirror or input. -->
  <ItemGroup Condition="'$(PlayhubHudDisplaySha256)' != '' and '$(PlayhubHudDisplayCallbackSha256)' != ''">
    <HudDisplayAssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PlayhubHudDisplaySha256</_Parameter1><_Parameter2>$(PlayhubHudDisplaySha256)</_Parameter2>
    </HudDisplayAssemblyAttribute>
    <HudDisplayAssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PlayhubHudDisplayCallbackSha256</_Parameter1><_Parameter2>$(PlayhubHudDisplayCallbackSha256)</_Parameter2>
    </HudDisplayAssemblyAttribute>
  </ItemGroup>
  <Target Name="GeneratePrivateHudDisplayPins" BeforeTargets="CoreCompile" Condition="'@(HudDisplayAssemblyAttribute)' != ''">
    <WriteCodeFragment Language="C#" AssemblyAttributes="@(HudDisplayAssemblyAttribute)" OutputFile="$(IntermediateOutputPath)HudDisplayPins.g.cs" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)HudDisplayPins.g.cs" /></ItemGroup>
  </Target>
  <ItemGroup><Compile Include="../Shared/EpicLaunchWindows.cs" Link="EpicLaunchWindows.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/EpicLaunchCatalog.cs" Link="EpicLaunchCatalog.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/EpicProtocolLaunchRequest.cs" Link="EpicProtocolLaunchRequest.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Playhub/Services/PlayhubUpdateService.cs" Link="PlayhubUpdateService.cs" /><Compile Include="../Playhub/Services/AppPaths.cs" Link="PlayhubAppPaths.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/EpicLaunchPayload.cs" Link="EpicLaunchPayload.cs" /></ItemGroup>
  <!-- Mark III boot sound (docs/eternal/brand/sound/eternal-core-boot.ogg as 16-bit PCM WAV), played by BootSequenceSound. -->
  <ItemGroup><EmbeddedResource Include="Assets/eternal-core-boot.wav" LogicalName="GamingMode.BootSound.wav" /></ItemGroup>
  <!-- Eternal Core: 0.3 s of black that replaces Steam's startup movie (Shared/SteamStartupMovie.cs). -->
  <ItemGroup><EmbeddedResource Include="Assets/core-skip-startup.webm" LogicalName="GamingMode.SkipStartupMovie.webm" /></ItemGroup>
  <!-- Eternal Core: the Steam update gate's known-good file (docs/eternal/STEAM-UPDATES.md). -->
  <ItemGroup><EmbeddedResource Include="../Shared/SteamCompatibility.json" LogicalName="SteamCompatibility.json" /></ItemGroup>
  <!-- Private first-content cover is independent of HUD/menu/input and OFF without exact pins. -->
  <ItemGroup Condition="'$(PlayhubCurtainDisplaySha256)' != '' and '$(PlayhubCurtainCallbackSha256)' != ''">
    <CurtainDisplayAssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PlayhubCurtainDisplaySha256</_Parameter1><_Parameter2>$(PlayhubCurtainDisplaySha256)</_Parameter2>
    </CurtainDisplayAssemblyAttribute>
    <CurtainDisplayAssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PlayhubCurtainCallbackSha256</_Parameter1><_Parameter2>$(PlayhubCurtainCallbackSha256)</_Parameter2>
    </CurtainDisplayAssemblyAttribute>
  </ItemGroup>
  <Target Name="GeneratePrivateCurtainDisplayPins" BeforeTargets="CoreCompile" Condition="'@(CurtainDisplayAssemblyAttribute)' != ''">
    <WriteCodeFragment Language="C#" AssemblyAttributes="@(CurtainDisplayAssemblyAttribute)" OutputFile="$(IntermediateOutputPath)CurtainDisplayPins.g.cs" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)CurtainDisplayPins.g.cs" /></ItemGroup>
  </Target>
  <ItemGroup><Compile Remove="GamingMode.Services/OwnedWin32GameFocus.cs" /></ItemGroup>
  <!-- Separate private bootstrap; default builds keep original shell lifetime. -->
  <PropertyGroup Condition="'$(XboxShellBootstrapTrial)' == 'true' and '$(ShellFreeOverlayTrial)' == 'true'">
    <DefineConstants>$(DefineConstants);PLAYHUB_XBOX_SHELL_BOOTSTRAP</DefineConstants>
  </PropertyGroup>
  <!-- Explicit private trial: no behavior changes without a pinned complete native group. -->
  <PropertyGroup Condition="'$(ShellFreeOverlayTrial)' == 'true'">
    <DefineConstants>$(DefineConstants);PLAYHUB_SHELL_FREE_OVERLAY_TRIAL</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(ShellFreeOverlayTrial)' == 'true' and '$(ShellFreeOverlayManifestSha256)' != ''">
    <ShellFreeOverlayAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PlayhubShellFreeTrialManifestSha256</_Parameter1><_Parameter2>$(ShellFreeOverlayManifestSha256)</_Parameter2>
    </ShellFreeOverlayAttribute>
  </ItemGroup>
  <Target Name="GenerateShellFreeOverlayPins" BeforeTargets="CoreCompile" Condition="'@(ShellFreeOverlayAttribute)' != ''">
    <WriteCodeFragment Language="C#" AssemblyAttributes="@(ShellFreeOverlayAttribute)" OutputFile="$(IntermediateOutputPath)ShellFreeOverlayPins.g.cs" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)ShellFreeOverlayPins.g.cs" /></ItemGroup>
  </Target>
</Project>
