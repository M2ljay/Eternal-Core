# Normalizza i fine-riga (niente sorprese tra editor).
* text=auto
*.cs    text eol=crlf
*.xaml  text eol=crlf
*.csproj text eol=crlf

# Tratta come binari (no normalizzazione).
*.png binary
*.jpg binary
*.ico binary
*.mp4 binary
*.exe binary

# Eternal Core: the official Decky 3.3.1 package pins its LICENSE byte-for-byte with LF endings,
# while its other text files are pinned with CRLF; CI checks out with core.autocrlf=true.
Source/Playhub/Assets/DeckyRuntime/Official-3.3.1/LICENSE -text
